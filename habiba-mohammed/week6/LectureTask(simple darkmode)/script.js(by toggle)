var btn = document.getElementById('mode');
btn.addEventListener("click",mode)
function mode(){
    const all = document.getElementById('all');
    let modevalue = btn.innerText;

    all.classList.toggle('dark')
    if(modevalue == 'dark')
    {
        btn.innerText = 'light';
    }
    else if(modevalue =='light')
    {
        btn.innerText = 'dark';
    }
}
