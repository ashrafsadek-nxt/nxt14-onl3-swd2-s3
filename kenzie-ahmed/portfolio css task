body {
    font-family: Arial, sans-serif;
    margin: 20px;
    background-color: #f4f4f4;
    color: #333;
}

/* Navigation Bar */
nav {
    background-color: #333;
    padding: 10px;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 10px;
}

nav a:hover {
    text-decoration: underline;
}

/* Headings */
h1,
h2,
h3 {
    color: #2c3e50;
}

/* Lists */
ul {
    list-style-type: square;
}

/* Form Styling */
form {
    background-color: #fff;
    padding: 15px;
    border: 1px solid #ccc;
    max-width: 400px;
}

input,
textarea {
    width: 100%;
    padding: 8px;
    margin-top: 5px;
    margin-bottom: 15px;
    border: 1px solid #ccc;
    border-radius: 4px;
}

/* Footer */
footer {
    text-align: center;
    margin-top: 30px;
    color: #666;
}
