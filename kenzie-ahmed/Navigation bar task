<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Navigation bar</title>
    <link rel="stylesheet" href="style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

</head>

<body>

    <nav>
        <!-- Left -->
        <div class="nav-left">
            <i class="fas fa-feather logo"></i>
            <a href="www.google.com">Home</a>
        </div>


        <!-- Center -->
        <div class="nav-center">
            <a href="#">About</a>
            <a href="#">Contact</a>
            <a href="#">Details</a>
        </div>

        <!-- Right -->
        <div class="nav-right">
            <i class="fas fa-moon"></i>
            <input type="text" class="search-input" placeholder="Search..." />
        </div>
    </nav>

</body>

</html>    





* {
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
}

/* Navbar Styling */
nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #222;
    color: white;
    padding: 1rem 2rem;
}

/* Left Section */
.nav-left {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.nav-left .logo {
    font-size: 2rem;
    color: white;
}

.nav-left a {
    color: white;
    text-decoration: none;
    font-size: 1.2rem;
}

/* Center Section */
.nav-center {
    display: flex;
    gap: 2rem;
}

.nav-center a {
    color: white;
    text-decoration: none;
    font-size: 1.1rem;
}

/* Right Section */
.nav-right {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.nav-right .fa-moon {
    cursor: pointer;
    font-size: 1.5rem;
    color: white;
}

.search-input {
    padding: 0.3rem 0.6rem;
    border-radius: 5px;
}
